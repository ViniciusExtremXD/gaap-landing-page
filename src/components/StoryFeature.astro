---
import { stories } from '../data/gaap';
import Arrow from './Arrow.astro';
import Media from './Media.astro';
const story = stories.find((entry) => entry.id === 'churros');
---
<section class="feature-story section-space" id="historias" aria-labelledby="story-title">
  <div class="container feature-grid">
    <div class="feature-image-wrap"><span class="vertical-caption" aria-hidden="true">CADA VIDA, UMA HISTÓRIA</span><Media mediaId="churros" class="feature-photo" fallbackTitle="Conheça a história do Churros." /><div class="handwritten-note">o começo de<br />um novo capítulo<svg viewBox="0 0 90 50" aria-hidden="true"><path d="M85 4C58 1 39 43 11 30m11-9-12 9 4 15" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></div></div>
    <div class="feature-copy"><p class="eyebrow"><span class="chapter-number">01 /</span> por trás de cada focinho</p><h2 id="story-title">Esse é o<br /><em>Churros.</em></h2><span class="status-pill"><span aria-hidden="true">↗</span> Um recomeço: adotado</span><p class="feature-lead">Um nome doce.<br />Uma história que continua.</p><p>{story?.summary || 'O GAAP compartilhou a procura por um novo lar para Churros. Depois, veio a atualização que dá sentido a todo esse cuidado: ele foi adotado.'}</p><a class="text-link" href={story?.url || 'https://www.instagram.com/gaap.porquinhos/p/DayekiAuliL/'} target="_blank" rel="noopener noreferrer">Ver a história no Instagram <Arrow diagonal /></a><span class="source-date">Registro do GAAP · julho de 2026</span></div>
  </div>
</section>
