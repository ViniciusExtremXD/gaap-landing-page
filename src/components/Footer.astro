---
import { siteUrl } from '../lib/site-url';
import { links } from '../data/gaap';
import Arrow from './Arrow.astro';
import Flower from './Flower.astro';
---
<footer class="site-footer"><div class="container"><div class="footer-invitation" data-reveal><div><p class="eyebrow">o álbum continua crescendo</p><h2>Até o próximo<br /><em>pequeno encontro.</em></h2></div><a href={links.instagram} target="_blank" rel="noopener noreferrer" class="button button-dark">@gaap.porquinhos <Arrow diagonal /></a></div><div class="footer-wordmark" aria-hidden="true"><span>gaap</span><Flower /></div><div class="footer-bottom"><p>Grupo de Apoio Amigos do Pudim<br /><span>Uma proposta de presença digital · em revisão</span></p><div class="footer-links"><a href={links.support} target="_blank" rel="noopener noreferrer">Apoia.se</a><a href={links.linktree} target="_blank" rel="noopener noreferrer">Canais do GAAP</a><a href={siteUrl('/privacidade/')}>Privacidade</a><button type="button" class="motion-toggle" data-motion-toggle aria-pressed="false"><span class="motion-icon" aria-hidden="true">◒</span><span data-motion-label>Reduzir movimentos</span></button></div></div></div></footer>
