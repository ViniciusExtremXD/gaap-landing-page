---
interface Props { mediaId: string }
const { mediaId } = Astro.props;
const cover = mediaId === 'zion'
  ? { label: 'um novo capítulo', title: 'A vida\nrecomeça.', motif: 'sun' }
  : mediaId === 'capuccino'
    ? { label: 'pequenos rituais', title: 'Pausa\npara o feno.', motif: 'hay' }
    : { label: 'afeto de pertinho', title: 'Carinho,\npor favor.', motif: 'heart' };
---
<div class:list={['publication-cover', `cover-${cover.motif}`]} aria-hidden="true">
  <span class="cover-kicker">{cover.label}</span>
  <svg class="cover-drawing" viewBox="0 0 260 190" fill="none">
    {cover.motif === 'sun' && <>
      <path class="cover-stroke" d="M36 150c18-30 47-22 67-3s44 19 60-6 38-26 61-7M82 111a49 49 0 0 1 98 0M130 25V11m-46 29L74 27m-20 58-18-3m159-33 12-14m-4 56 19-4" />
      <path class="cover-stroke secondary-stroke" d="m155 139 8 6 8-6M103 105h1m29 0h1" />
      <circle class="cover-orbit" cx="217" cy="136" r="5" />
    </>}
    {cover.motif === 'hay' && <>
      <path class="cover-stroke" d="M90 171c7-65-6-98-26-135m61 137c6-77 23-116 41-149m-6 149c-4-52 11-89 48-116M83 102C42 96 44 73 44 73c32 0 35 18 39 29Zm-7-29c19-17 9-36 9-36-20 16-14 26-9 36Zm62 32c-23-21-19-41-19-41 27 7 24 26 19 41Zm9-25c32 2 43-24 43-24-29-5-37 10-43 24Zm24 41c-17-24-5-44-5-44 20 14 13 34 5 44Z" />
      <path class="cover-stroke secondary-stroke" d="m197 142 7-4m-147-8-8-3M107 24l3-10" />
    </>}
    {cover.motif === 'heart' && <>
      <path class="cover-stroke" d="M129 155C89 127 61 109 63 78c3-39 51-41 66-8 19-36 67-28 67 8 0 32-33 54-67 77Z" />
      <path class="cover-stroke secondary-stroke" d="M50 126c-28-23-20-73 10-91M206 41c35 22 38 66 14 91M122 25l3-14m-78 70-17-2m195 0 17-3" />
      <circle class="cover-orbit" cx="201" cy="156" r="5" />
    </>}
  </svg>
  <span class="cover-headline">{cover.title.split('\n').map(line => <span>{line}</span>)}</span>
  <span class="cover-signature">do universo do GAAP <span>↗</span></span>
</div>
