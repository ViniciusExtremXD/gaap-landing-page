---
import { links } from '../data/gaap';
import { siteUrl } from '../lib/site-url';
import Arrow from './Arrow.astro';
import '../styles/header.css';
---
<header class="site-header gaap-header" data-header>
  <div class="header-inner container">
    <a href={siteUrl('/')} class="brand" aria-label="GAAP — Grupo de Apoio Amigos do Pudim — início">
      <span class="brand-emblem"><img src={siteUrl('/media/logo.webp')} width="80" height="80" alt="" /></span>
      <span class="brand-identity"><span class="brand-word">gaap<span class="brand-dot">.</span></span><span class="brand-caption"><span class="brand-caption-intro">Grupo de Apoio<br /></span>Amigos do Pudim</span></span>
    </a>
    <nav class="desktop-nav" aria-label="Principal">
      <a href={siteUrl('/#o-projeto')}>O projeto</a>
      <a href={siteUrl('/#historias')}>Histórias</a>
      <a href={siteUrl('/#como-ajudar')}>Como ajudar</a>
    </nav>
    <div class="header-actions">
      <nav class="header-socials" aria-label="Canais do GAAP">
        <a href={links.instagram} class="header-social-link" target="_blank" rel="noopener noreferrer">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6" /><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" /></svg>
          Instagram
        </a>
        <a href={links.linktree} class="header-social-link" target="_blank" rel="noopener noreferrer">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v12m-6-9 6 6 6-6M4 11h16m-8 1-6 6m6-6 6 6m-6 0v4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
          Linktree
        </a>
      </nav>
      <a href={links.support} class="button button-dark header-support" target="_blank" rel="noopener noreferrer"><span>Apoiar<span class="support-label-extra"> o projeto</span></span><Arrow diagonal /></a>
      <button type="button" class="menu-toggle" data-menu-toggle aria-controls="mobile-navigation" aria-expanded="false" aria-label="Abrir menu"><span></span><span></span></button>
    </div>
  </div>
  <nav id="mobile-navigation" data-mobile-menu class="mobile-nav" aria-label="Principal no celular" hidden>
    <div class="mobile-menu-inner container">
      <span class="mobile-menu-label">Chegue mais perto</span>
      <div class="mobile-menu-pages">
        <a href={siteUrl('/#o-projeto')}><span><small>01</small>O projeto</span><Arrow /></a>
        <a href={siteUrl('/#historias')}><span><small>02</small>Histórias</span><Arrow /></a>
        <a href={siteUrl('/#como-ajudar')}><span><small>03</small>Como ajudar</span><Arrow /></a>
      </div>
      <div class="mobile-menu-socials">
        <a href={links.instagram} target="_blank" rel="noopener noreferrer"><span><small>Acompanhe de pertinho</small>Instagram</span><Arrow diagonal /></a>
        <a href={links.linktree} target="_blank" rel="noopener noreferrer"><span><small>Todos os nossos links</small>Linktree</span><Arrow diagonal /></a>
      </div>
    </div>
  </nav>
  <noscript>
    <nav class="header-static-links container" aria-label="Navegação e canais do GAAP">
      <a href={siteUrl('/#o-projeto')}>O projeto</a>
      <a href={siteUrl('/#historias')}>Histórias</a>
      <a href={siteUrl('/#como-ajudar')}>Como ajudar</a>
      <a href={links.instagram} target="_blank" rel="noopener noreferrer">Instagram <Arrow diagonal /></a>
      <a href={links.linktree} target="_blank" rel="noopener noreferrer">Linktree <Arrow diagonal /></a>
    </nav>
  </noscript>
  <div class="header-progress" aria-hidden="true"><span></span></div>
</header>
